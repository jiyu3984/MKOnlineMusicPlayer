{
  "name": "mkonline-music-player",
  "productName": "MK在线音乐播放器",
  "version": "2.44.0",
  "description": "支持多平台的在线音乐播放器桌面版",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --debug",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl",
    "cap:init": "cap init",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "build:android": "cap sync && cap copy && cap open android",
    "serve": "http-server -p 8080"
  },
  "keywords": [
    "music",
    "player",
    "electron",
    "网易云音乐",
    "QQ音乐"
  ],
  "author": "MK",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@capacitor/cli": "^5.5.0",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "@capacitor/core": "^5.5.0",
    "@capacitor/android": "^5.5.0",
    "@capacitor/ios": "^5.5.0",
    "@capacitor/app": "^5.0.6",
    "@capacitor/browser": "^5.1.0",
    "@capacitor/storage": "^1.2.5",
    "@capacitor/network": "^5.0.6"
  },
  "build": {
    "appId": "com.mkmusic.player",
    "productName": "MK音乐播放器",
    "copyright": "Copyright © 2024 MK",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "api.php",
      "js/**/*",
      "css/**/*",
      "images/**/*",
      "plugns/**/*",
      "!cache",
      "!temp",
      "!node_modules"
    ],
    "protocols": [
      {
        "name": "MK音乐协议",
        "schemes": [
          "mkmusic"
        ],
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MK音乐播放器",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "MK音乐播放器安装",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "Audio",
      "synopsis": "在线音乐播放器",
      "description": "支持网易云、QQ音乐、酷狗等多平台的在线音乐播放器"
    }
  }
}
